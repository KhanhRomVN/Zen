{
  "name": "@khanhromvn/ts-reap",
  "version": "0.1.0",
  "description": "Advanced TypeScript/JavaScript language server that detects project-wide unused exports, functions, and variables — the gap vanilla tsserver leaves open.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "ts-reap": "dist/server.js",
    "ts-reap-check": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p .",
    "watch": "tsc -p . --watch",
    "start": "node dist/server.js --stdio",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "test": "echo \"No tests yet\" && exit 0"
  },
  "keywords": [
    "lsp",
    "language-server",
    "typescript",
    "javascript",
    "unused-exports",
    "dead-code",
    "static-analysis",
    "ts-morph",
    "code-quality"
  ],
  "author": "khanhromvn",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/khanhromvn/ts-reap.git"
  },
  "bugs": {
    "url": "https://github.com/khanhromvn/ts-reap/issues"
  },
  "homepage": "https://github.com/khanhromvn/ts-reap#readme",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "ts-morph": "^23.0.0",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.11"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0"
  }
}
